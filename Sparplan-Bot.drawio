        <mxCell id="jj22TwtniHC2MtT9gg5F-58" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;p data-pm-slice=&quot;1 3 []&quot; style=&quot;text-align: left;&quot;&gt;&lt;strong&gt;So funktioniert der Bot&lt;/strong&gt;&lt;/p&gt;&lt;p style=&quot;text-align: left;&quot;&gt;Der Bot passt die tägliche Kaufmenge automatisch an die aktuelle Marktlage an. Grundlage ist der &lt;strong&gt;Fear &amp;amp; Greed Index von CoinMarketCap&lt;/strong&gt;.&lt;/p&gt;&lt;p style=&quot;text-align: left;&quot;&gt;&lt;strong&gt;Kauflogik nach Fear &amp;amp; Greed Index&lt;/strong&gt;&lt;/p&gt;&lt;ul data-spread=&quot;false&quot;&gt;&lt;li&gt;&lt;p style=&quot;text-align: left;&quot;&gt;&lt;strong&gt;Extreme Greed (80–100):&lt;/strong&gt; 25 % der gewählten Kaufmenge&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p style=&quot;text-align: left;&quot;&gt;&lt;strong&gt;Greed (60–79):&lt;/strong&gt; 50 % der gewählten Kaufmenge&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p style=&quot;text-align: left;&quot;&gt;&lt;strong&gt;Neutral (40–60):&lt;/strong&gt; 100 % der gewählten Kaufmenge&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p style=&quot;text-align: left;&quot;&gt;&lt;strong&gt;Fear (20–39):&lt;/strong&gt; 200 % der gewählten Kaufmenge&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p style=&quot;text-align: left;&quot;&gt;&lt;strong&gt;Extreme Fear (0–19):&lt;/strong&gt; 400 % der gewählten Kaufmenge&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p style=&quot;text-align: left;&quot;&gt;&lt;strong&gt;Weitere Funktionen&lt;/strong&gt;&lt;/p&gt;&lt;ul data-spread=&quot;false&quot;&gt;&lt;li&gt;&lt;p style=&quot;text-align: left;&quot;&gt;Automatische Auszahlung der Bitcoins auf Ihre &lt;strong&gt;Hardware-Wallet&lt;/strong&gt; ab einem definierten Betrag&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p style=&quot;text-align: left;&quot;&gt;Einrichtung und Steuerung vollständig über &lt;strong&gt;Telegram&lt;/strong&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(51, 51, 255));&quot;&gt;&lt;b style=&quot;&quot;&gt;[Erklärvideo: Funktion]&amp;nbsp;&lt;/b&gt;&lt;b&gt;[Erklärvideo: Sicherheit] [Weiter]&lt;/b&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="400" width="470" x="-715" y="-295.5" as="geometry" />
        </mxCell>
        <mxCell id="jj22TwtniHC2MtT9gg5F-66" edge="1" parent="1" source="jj22TwtniHC2MtT9gg5F-59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="jj22TwtniHC2MtT9gg5F-58" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="jj22TwtniHC2MtT9gg5F-59" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;LOGO&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;p data-pm-slice=&quot;1 1 []&quot; style=&quot;text-align: left;&quot;&gt;&lt;strong&gt;Willkommen beim Krypto-World Sparplan-Bot&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Dieser Sparplan-Bot automatisiert Ihren täglichen Bitcoin-Kauf vollständig und regelbasiert.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Täglich um &lt;/span&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;20:00 Uhr&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; kauft der Bot Bitcoin über Ihr &lt;/span&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;eigenes Exchange-Konto&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; (Anbindung per API-Key).&lt;/span&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;&lt;p style=&quot;text-align: left;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p data-pm-slice=&quot;1 3 []&quot; style=&quot;text-align: left;&quot;&gt;&lt;strong&gt;Unterstützte Exchanges&lt;/strong&gt;&lt;/p&gt;&lt;ul data-spread=&quot;false&quot;&gt;&lt;li&gt;&lt;p style=&quot;text-align: left;&quot;&gt;Kraken&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p style=&quot;text-align: left;&quot;&gt;Coinbase &lt;em&gt;(folgt)&lt;/em&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p style=&quot;text-align: left;&quot;&gt;Binance &lt;em&gt;(folgt)&lt;/em&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;p data-pm-slice=&quot;1 3 []&quot;&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Mindestanforderungen:&lt;/strong&gt;&lt;/p&gt;&lt;ul data-spread=&quot;false&quot;&gt;&lt;li&gt;&lt;p&gt;&lt;strong&gt;Tägliche Mindestkaufmenge:&lt;/strong&gt; 5 €&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;p data-pm-slice=&quot;1 3 []&quot;&gt;&lt;strong&gt;Kosten &amp;amp; Abrechnung&lt;/strong&gt;&lt;/p&gt;&lt;ul data-spread=&quot;false&quot;&gt;&lt;li&gt;&lt;p&gt;&lt;strong&gt;2,5 % Gebühr auf die jeweilige Kaufmenge&lt;/strong&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;strong&gt;Monatliche Abrechnung per Rechnung&lt;/strong&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(51, 51, 255));&quot;&gt;[STARTEN]&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;" vertex="1">
