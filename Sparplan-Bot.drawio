        <mxCell id="X9ea8_CBoqbZrk9XYFZT-18" connectable="0" parent="jj22TwtniHC2MtT9gg5F-61" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="[Weiter]" vertex="1">
