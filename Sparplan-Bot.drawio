        <mxCell id="jj22TwtniHC2MtT9gg5F-121" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;b&gt;Letzter Kauf:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Fear &amp;amp; Greed Index: 25&lt;b&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Multiplikator: 2&lt;/div&gt;&lt;div&gt;Kaufpreis BTC: 80505,70 €&lt;/div&gt;&lt;div&gt;Kaufmenge: 150 € / 0,0018631 BTC (186321.0 Sats)&lt;/div&gt;&lt;div&gt;Exchange-Gebühr: 0,525 €&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Bestand Börse:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;BTC-Bestand gesamt&lt;/div&gt;&lt;div&gt;Euro-Bestand gesamt&lt;br&gt;BTC-Bestand durch Bot in BTC und EUR&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Aktueller Fear &amp;amp; Greed Index&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Performance&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Die letzten 30 Tage in %&lt;/div&gt;&lt;div&gt;Das letzte Jahr&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;in %&lt;/span&gt;&lt;/div&gt;&lt;div&gt;Gesamt&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;in %&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(51, 51, 255));&quot;&gt;[Kaufhistorie anzeigen] [Transaktionshistorie anzeigen]&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Änderungen&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(51, 51, 255));&quot;&gt;[Private Daten ändern] [Api-Keys ändern] [Kaufbetrag ändern] [Wallet ändern] [Wallet-Betrag ändern] [Börse ändern]&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Sonstiges&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(51, 51, 255));&quot;&gt;&lt;b&gt;[Transaktion an Wallet] (Menübaum erstellen)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Erkärvideos&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(51, 51, 255));&quot;&gt;&lt;b&gt;[Vorstellung] [Funktion] [Sicherheit] [Wallet]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(51, 51, 255));&quot;&gt;[AKTUALISIEREN]&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;" vertex="1">
